<%- include('partials/header', { title: 'Log in' }) %>
<section class="container narrow">
  <div class="panel">
    <h1>Log in</h1>
    <% if (error) { %><p class="flash flash-error" role="alert"><%= error %></p><% } %>
    <form method="POST" action="/login">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" value="<%= email %>" autocomplete="email" required>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <button class="btn btn-hl" type="submit">Log in</button>
    </form>
    <p class="alt">New here? <a href="/register">Create an account</a></p>
  </div>
</section>
<%- include('partials/footer') %>
